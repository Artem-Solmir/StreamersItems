# Скопируйте в .env для локальной разработки.
# На Vercel задайте те же ключи в Environment Variables.
# Vite отдаёт в бандл только переменные с префиксом VITE_.

# VITE_API_URL=https://example.com/api

# Twitch Helix (server only — refreshes streamer profile photos on /api/twitch/users)
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# Item suggestions → Google Sheet (scripts/google-sheets-suggest-apps-script.js → Code.gs)
# If Extensions → Apps Script fails in Sheets, use script.google.com + SPREADSHEET_ID (see file header)
# URL must end with /exec (Deploy → Web app → Who has access: Anyone)
# GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/XXXX/exec
# GOOGLE_SHEETS_SUBMIT_SECRET=optional-shared-secret
