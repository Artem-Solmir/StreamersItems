# Скопируйте в .env для локальной разработки.
# На Vercel задайте те же ключи в Environment Variables.
# Vite отдаёт в бандл только переменные с префиксом VITE_.

# --- Twitch (Helix API) ---
# Создайте приложение: https://dev.twitch.tv/console/apps
# Client ID и Secret храните только на сервере (Vercel / vercel dev).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Логины каналов через запятую (публично в клиенте).
# VITE_TWITCH_STREAMER_LOGINS=shroud,ninja
